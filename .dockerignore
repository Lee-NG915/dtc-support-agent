# Version control and developer workspace metadata
.git
.gitignore
.gitattributes
.github
.claude
.agents
.dtc
.work
.workbuddy-ai/
.tmpcmp/
.cursor/
.aider*
.code-review-graph

# Secrets and environment variants (never part of an image)
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
secrets/
deploy/secrets/

# Production deployment env files and credentials, including nested paths.
**/.env
**/.env.*
deploy/dtc.production.env
deploy/dtc.production.env.*
deploy/*.env
deploy/**/*.env
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/credentials.json
**/secrets/

# Local runtimes, caches and coverage
.venv
venv
env/
frontend/node_modules
frontend/dist
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov/
.tox/
*.egg-info
dist/
build/

# Local data and generated reports
data
*.sqlite3
*.db
output/
.eval-cache/
eval/reports
reports/
logs/
*.log

# Development-only material. knowledge/ must stay in the context because the
# application ingests its Markdown at startup.
tests
docs
.idea
.vscode
.DS_Store
Thumbs.db
