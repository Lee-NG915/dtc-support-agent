# Production environment template for docker-compose.production.yml.
#
# Copy this file outside the repository, replace every placeholder, then:
#   sudo chown root:root /etc/dtc/production.env
#   sudo chmod 0600 /etc/dtc/production.env
#   export DTC_ENV_FILE=/etc/dtc/production.env
#
# Never commit a filled-in copy. The checker rejects files whose mode is not
# 0400 or 0600 and never prints the values it reads:
#   uv run python scripts/check_production_settings.py --env-file "$DTC_ENV_FILE"
#
# Values that look like CHANGE_ME/REPLACE_* are placeholders, not secrets.
# URL-encode reserved characters in POSTGRES_PASSWORD and keep the same value
# in DATABASE_URL. Compose uses POSTGRES_* to initialise the database; the API
# and worker use DATABASE_URL.

APP_ENV=production
LOG_LEVEL=INFO
KNOWLEDGE_DIR=knowledge

# After-sales pilot. Fake is development-only and must not reach production.
AFTER_SALES_ENABLED=true
BUSINESS_CONNECTOR=epig

# Local PostgreSQL inside the Compose network. PostgreSQL publishes no host
# port; the API reaches it only over the Compose bridge network.
POSTGRES_USER=dtc
POSTGRES_PASSWORD=replace-with-a-long-random-url-encoded-password
POSTGRES_DB=dtc_production
DATABASE_URL=postgresql+asyncpg://dtc:replace-with-a-long-random-url-encoded-password@postgres:5432/dtc_production
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# No local Redis or Qdrant in the single-host pilot. Leave both empty until an
# external service, capacity plan and failure/retry behaviour are approved.
REDIS_URL=
QDRANT_URL=

# E-pig production contract. Must be HTTPS; do not append a query string,
# credentials or fragment.
EPIG_BASE_URL=https://replace-with-epig-production-host.invalid
EPIG_SERVICE_TOKEN=replace-with-epig-service-token
EPIG_ALLOWED_MARKETS=au,sg,us
EPIG_TIMEOUT_SECONDS=5
EPIG_MAX_CONNECTIONS=10

# Server-trusted SKU -> policy product category mapping. Real production SKUs
# must be reviewed before use; an empty map leaves evidence in needs_info.
AFTER_SALES_SKU_CATEGORY_MAP={"REPLACE-WITH-REVIEWED-SKU":"homewares"}
AFTER_SALES_APPROVAL_TTL_SECONDS=14400
AFTER_SALES_SYNC_BATCH_LIMIT=50

# Continuous worker scope must be a non-empty subset of EPIG_ALLOWED_MARKETS.
AFTER_SALES_WORKER_MARKETS=au,sg,us
AFTER_SALES_WORKER_BATCH_LIMIT=10
AFTER_SALES_WORKER_POLL_INTERVAL_SECONDS=2
AFTER_SALES_WORKER_LEASE_SECONDS=60
AFTER_SALES_WORKER_OPERATION_TIMEOUT_SECONDS=20
AFTER_SALES_WORKER_LOOKUP_BUDGET=10
AFTER_SALES_WORKER_WRITE_BUDGET=3
AFTER_SALES_WORKER_RETRY_BASE_SECONDS=1
AFTER_SALES_WORKER_RETRY_MAX_SECONDS=60
AFTER_SALES_WORKER_RECONCILIATION_MAX_SECONDS=86400

# Fixed-password demo login is development-only. Production startup refuses it.
AFTER_SALES_DEMO_LOGIN_ENABLED=false

# Backend secrets. Use distinct, high-entropy values and rotate them on a
# documented schedule. Never reuse the demo password.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Leave both embedding values empty only when BM25-only retrieval is acceptable
# for the pilot. An untouched copy keeps the acknowledgement false so preflight
# rejects it; set it to true only after explicitly accepting the degradation. It
# does not claim that retrieval quality has been accepted or evaluated in
# production.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
PRODUCTION_ACKNOWLEDGE_BM25_ONLY=false

# Image defaults are already safe. Keep local model loaders and MCP disabled
# unless a separate capacity/licence review approves them.
LOCAL_EMBEDDING_ENABLED=false
CROSS_ENCODER_ENABLED=false
UNSTRUCTURED_ENABLED=false
MCP_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
